    stretchConn = RunService.RenderStepped:Connect(function()
        cam.CFrame = cam.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, 0.75, 0, 0, 0, 1) 
    end) 
end

-- ==========================================
-- FPS BOOSTER MIGLIORATO
-- ==========================================
local function applyFPS()
    if not fpsEnabled then return end
    
    -- Disabilita ombre globali
    Lighting.GlobalShadows = false
    Lighting.Ambient = Color3.fromRGB(255, 255, 255)
    Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    Lighting.Brightness = 1
    
    -- Riduci qualità rendering
    pcall(function() 
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 
    end)
    
    -- Disabilita effetti atmosferici
    for _, v in pairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") or v:IsA("Bloom") or v:IsA("Blur") or v:IsA("ColorCorrection") or v:IsA("SunRays") or v:IsA("DepthOfField") then
            v.Enabled = false
        end
    end
    
    -- Ottimizza parti esistenti
    local function optimizePart(o)
        if o:IsA("BasePart") then 
            o.Material = Enum.Material.SmoothPlastic 
            o.Reflectance = 0
            o.CastShadow = false
        elseif o:IsA("Decal") or o:IsA("Texture") then
            o.Transparency = 1
        elseif o:IsA("ParticleEmitter") or o:IsA("Trail") then
            o.Enabled = false
        elseif o:IsA("Fire") or o:IsA("Smoke") or o:IsA("Sparkles") then
            o.Enabled = false
        end
    end
    
    -- Ottimizza workspace
    for _, v in pairs(Workspace:GetDescendants()) do 
        optimizePart(v) 
    end
    
    -- Ottimizza nuovi oggetti
    Workspace.DescendantAdded:Connect(optimizePart)
    
    -- Disabilita animazioni complesse dei player
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.Animator:Destroy()
            end
        end
    end
end

-- WALLHOP
local rP = RaycastParams.new()
rP.FilterType = Enum.RaycastFilterType.Blacklist

local function getWall()
    local c = LocalPlayer.Character
    if not c then return nil end
    local r = c:FindFirstChild("HumanoidRootPart")
    if not r then return nil end
    rP.FilterDescendantsInstances = {c}
    local dirs = {r.CFrame.LookVector, -r.CFrame.LookVector, r.CFrame.RightVector, -r.CFrame.RightVector}
    local h, md = nil, wallDistance + 1
    for _, d in pairs(dirs) do 
        local ry = workspace:Raycast(r.Position, d * wallDistance, rP)
        if ry and ry.Instance and ry.Distance < md then 
            md = ry.Distance 
            h = ry 
        end 
    end 
    return h 
end

UserInputService.JumpRequest:Connect(function()
    if not wallHopEnabled or not debounceJump then return end
    local c = LocalPlayer.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not (h and r) then return end
    local w = getWall()
    if w then 
        debounceJump = false
        local wn = w.Normal
        local hwn = Vector3.new(wn.X, 0, wn.Z).Unit
        if hwn.Magnitude < 0.1 then 
            hwn = (r.CFrame.LookVector * Vector3.new(1, 0, 1)).Unit 
        end
        local b = hwn
        local cl = workspace.CurrentCamera.CFrame.LookVector
        local hcl = Vector3.new(cl.X, 0, cl.Z).Unit
        local ma = math.rad(12)
        local dt = math.clamp(b:Dot(hcl), -1, 1)
        local ab = math.acos(dt)
        local cr = b:Cross(hcl)
        local rs = math.sign(cr.Y)
        if rs == 0 then ab = 0 end
        local aa = math.min(ab, ma)
        local ar = CFrame.Angles(0, aa * rs, 0)
        local it = ar * b
        r.CFrame = CFrame.lookAt(r.Position, r.Position + it)
        RunService.Heartbeat:Wait()
        h:ChangeState(Enum.HumanoidStateType.Jumping)
        h.JumpPower = 27
        r.CFrame = CFrame.lookAt(r.Position, r.Position - b)
        task.wait(0.35)
        debounceJump = true 
    end 
end)

