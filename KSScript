local function tw(obj, props, t, style, dir)
    local tween = TweenService:Create(obj, TweenInfo.new(t or 0.5, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

-- ==========================================
-- HITBOX EXPANDER
-- ==========================================
local function createHitboxForPlayer(player)
    if not player or not player.Character then return end
    if player == LocalPlayer then return end
    
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Rimuovi vecchia hitbox se esiste
    if hitboxParts[player] then
        hitboxParts[player]:Destroy()
        hitboxParts[player] = nil
    end
    
    -- Crea parte espansa
    local expander = Instance.new("Part")
    expander.Name = "HitboxExpander"
    expander.Size = Vector3.new(hitboxSize * 2, hitboxSize * 2, hitboxSize * 2)
    expander.CFrame = hrp.CFrame
    expander.Anchored = true
    expander.CanCollide = false
    expander.Transparency = hitboxVisible and 0.7 or 1
    expander.Color = C.hitbox
    expander.Material = Enum.Material.ForceField
    expander.Parent = player.Character
    
    -- Connessione per seguire il player
    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            if connection then connection:Disconnect() end
            if hitboxParts[player] then
                hitboxParts[player]:Destroy()
                hitboxParts[player] = nil
            end
            return
        end
        
        if hitboxParts[player] then
            hitboxParts[player].CFrame = player.Character.HumanoidRootPart.CFrame
            hitboxParts[player].Size = Vector3.new(hitboxSize * 2, hitboxSize * 2, hitboxSize * 2)
            hitboxParts[player].Transparency = hitboxVisible and 0.7 or 1
        end
    end)
    
    hitboxParts[player] = expander
end

local function removeAllHitboxes()
    for player, part in pairs(hitboxParts) do
        if part then part:Destroy() end
    end
    hitboxParts = {}
end

local function updateHitboxSystem()
    if not hitboxEnabled then
        removeAllHitboxes()
        return
    end
    
    -- Aggiungi hitbox a tutti i player esistenti
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            createHitboxForPlayer(player)
        end
    end
end

